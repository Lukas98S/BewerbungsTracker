<UserControl x:Class="BewerbungsTracker.ArchivAnsicht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BewerbungsTracker"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F5F5F5">
        <DataGrid ItemsSource="{Binding AbgelehnteBewerbungen}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*"/>
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                <DataGridTemplateColumn Header="Status" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                                       ItemsSource="{Binding DataContext.StatusListe, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                                       BorderThickness="0"
                                       VerticalAlignment="Center"
                                       Margin="2">     
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" >
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="Black"/>

                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
